{
  "name": "questbranch",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "AI-native branching research workspace",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "tsx src/preview/server.ts",
    "preview": "tsx src/preview/server.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && electron-vite build && vite build --config vite.web.config.ts",
    "package:dir": "pnpm build && electron-builder --dir",
    "start": "electron .",
    "format": "prettier --write src tests config scripts *.ts *.json *.yaml",
    "format:check": "prettier --check src tests config scripts *.ts *.json *.yaml",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "measure:layout": "tsx scripts/measure-layout.ts",
    "verify:desktop": "electron scripts/verify-desktop.mjs"
  },
  "build": {
    "appId": "org.questbranch.app",
    "productName": "QuestBranch",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
